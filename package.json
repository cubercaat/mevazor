{
  "name": "mevazor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mevazor - fruit-only marketplace (customer app + admin panel)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
